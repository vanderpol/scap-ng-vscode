{
  "name": "scap-ng-vscode-metadata",
  "version": "0.0.1",
  "private": true,
  "description": "Offline schema metadata and source-preservation foundation; not yet a VS Code extension",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs",
    "bootstrap:deps": "python3 scripts/bootstrap_dependencies.py",
    "bootstrap:pack": "python3 scripts/bootstrap_dependencies.py --with-pack",
    "verify:offline": "python3 scripts/bootstrap_dependencies.py --offline --with-pack",
    "package": "npm run package:vsix",
    "package:vsix": "node scripts/package-vsix.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "schema-profile.json",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "displayName": "SCAP-NG Assessment Studio",
  "publisher": "vanderpol",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:scapNg.assessmentStudio",
    "onCommand:scapNg.showPin"
  ],
  "contributes": {
    "commands": [
      {
        "command": "scapNg.showPin",
        "title": "SCAP-NG: Show pinned contract"
      },
      {
        "command": "scapNg.searchIndex",
        "title": "SCAP-NG: Search Assessment Studio"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scapNg.assessmentStudio",
          "title": "Assessment Studio",
          "icon": "media/scap-ng.svg"
        }
      ]
    },
    "views": {
      "scapNg.assessmentStudio": [
        {
          "id": "scapNg.assessmentStudio",
          "name": "Assessment Studio"
        }
      ]
    },
    "viewsWelcome": [],
    "configuration": {
      "title": "SCAP-NG Assessment Studio",
      "properties": {
        "scapNg.schemaPackPath": {
          "type": "string",
          "description": "Absolute path to a verified offline SCAP-NG editor metadata pack. The pinned schema-profile.json is always checked."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "scapNg.assessment",
        "displayName": "SCAP-NG Assessment",
        "selector": [
          {
            "filenamePattern": "**/*.assessment.yaml"
          },
          {
            "filenamePattern": "**/*.assessment.yml"
          }
        ],
        "priority": "option"
      }
    ]
  }
}
